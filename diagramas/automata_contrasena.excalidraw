    {
      "id": "reglas",
      "type": "text",
      "x": 100,
      "y": 60,
      "width": 500,
      "height": 120,
      "text": "REGLAS (todas deben cumplirse):\n1. Longitud ≥ 8 caracteres\n2. Al menos 1 mayúscula [A-Z]\n3. Al menos 1 minúscula [a-z]\n4. Al menos 1 dígito [0-9]\n5. Al menos 1 especial [!@#$%^&*()]\n6. Sin espacios en blanco",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
