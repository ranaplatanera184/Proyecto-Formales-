    {
      "id": "leyenda",
      "type": "text",
      "x": 50,
      "y": 350,
      "width": 400,
      "height": 150,
      "text": "LEYENDA:\n● q0: Estado inicial\n■ q1-q5: Estados de procesamiento\n◎ qf: Estado final (token producido)\n\nTOKENS PRODUCIDOS:\n- PALABRA / PALABRA RESERVADA\n- NÚMERO / CADENA\n- CORREO / VALOR\n- COMA / DOS PUNTOS / PUNTO Y COMA",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
